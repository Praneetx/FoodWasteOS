# --- Backend ---
APP_ENV=development
# dev | supabase   (dev trusts a demo tenant, NEVER enable in production)
AUTH_MODE=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/foodwasteos
ALLOWED_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

# Supabase Auth (required when AUTH_MODE=supabase)
SUPABASE_URL=
SUPABASE_JWT_AUD=authenticated
# Legacy projects only; leave empty to verify via JWKS
SUPABASE_JWT_SECRET=

# Forecast settings
FORECAST_SERVICE_LEVEL=0.85
FORECAST_HISTORY_DAYS=180
ML_ARTIFACT_DIR=./artifacts
MAX_CSV_BYTES=5000000

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shared secret for the nightly job (POST /api/v1/cron/generate, header X-Cron-Secret).
# Leave empty to disable the endpoint. Generate one with: openssl rand -hex 32
CRON_SECRET=
